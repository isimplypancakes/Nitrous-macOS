# Xcode project is generated by XcodeGen from project.yml
*.xcodeproj/
*.xcworkspace/

# Build output
build/
build-*/
DerivedData/
*.ipa
*.xcarchive
*.dSYM

# Local signing / distribution config
ExportOptions.local.plist

# macOS
.DS_Store

# User data that must never be committed
wallpaper.jpg
*-diagnostics.json

# Signing material — must never be committed
*.mobileprovision
*.p12
*.cer
*.p8
*.certSigningRequest
xcuserdata/
